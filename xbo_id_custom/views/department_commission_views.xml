<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_department_commission_list" model="ir.ui.view">
            <field name="name">department.commission.list</field>
            <field name="model">department.commission</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="company_id" options="{'no_open': True}"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_department_commission_form" model="ir.ui.view">
            <field name="name">department.commission.form</field>
            <field name="model">department.commission</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirmed" type="object" string="Confirmed" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_cancelled" type="object" string="Cancelled" class="oe_highlight" invisible="state != 'confirmed'"/>

                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="company_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}"/>
                            </group>
                            <group>
                                <field name="date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="department_commission_line" readonly="state != 'draft'">
                                    <list string="Lines" editable="bottom" >
                                        <field name="department_id" domain="[('company_id', '=', parent.company_id)]" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}"/>
                                        <field name="target_amount" />
                                        <field name="percentage" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_department_commission" model="ir.actions.act_window">
            <field name="name">Department Commission</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">department.commission</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Department Commission...!
                </p>
            </field>
        </record>


        <menuitem id="menu_action_department_commission"
                  name="Department Commission"
                  parent="menu_action_main_commission"
                  action="action_department_commission"
                  sequence="2"/>

    </data>
</odoo>
