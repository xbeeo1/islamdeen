<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_branch_commission_list" model="ir.ui.view">
            <field name="name">branch.commission.list</field>
            <field name="model">branch.commission</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_branch_commission_form" model="ir.ui.view">
            <field name="name">branch.commission.form</field>
            <field name="model">branch.commission</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirmed" type="object" string="Confirmed" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_cancelled" type="object" string="Cancelled" class="oe_highlight" invisible="state != 'confirmed'"/>

                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="branch_commission_line" readonly="state != 'draft'">
                                    <list string="Lines" editable="bottom" >
                                        <field name="company_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}"/>
                                        <field name="target_amount" />
                                        <field name="percentage" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_branch_commission" model="ir.actions.act_window">
            <field name="name">Branch Commission</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">branch.commission</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Branch Commission...!
                </p>
            </field>
        </record>

        <menuitem id="menu_action_main_commission"
                  name="Commissions"
                  parent="sale.menu_sale_config"
                  sequence="3"/>

        <menuitem id="menu_action_branch_commission"
                  name="Branch Commission"
                  parent="menu_action_main_commission"
                  action="action_branch_commission"
                  sequence="1"/>

    </data>
</odoo>
