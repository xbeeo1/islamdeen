<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="fund_transfer_wizard_form_view" model="ir.ui.view">
            <field name="name">cfund.transfer.form</field>
            <field name="model">fund.transfer</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="sender_account_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}" />
                                <field name="amount"/>
                                <field name="current_company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="company_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}" />
                                <field name="receiver_account_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}" />
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" data-hotkey="q"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="fund_transfer_window_act" model="ir.actions.act_window">
            <field name="name">Fund Transfer</field>
            <field name="res_model">fund.transfer</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="fund_transfer_wizard_form_view"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_fund_transfer"
              name="Fund Transfer"
              action="fund_transfer_window_act"
              parent="account.menu_finance"
              sequence="4"/>



    </data>

</odoo>